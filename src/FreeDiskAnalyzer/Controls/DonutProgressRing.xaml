<UserControl x:Class="FreeDiskAnalyzer.Controls.DonutProgressRing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="160" Height="160">
    <Grid>
        <Ellipse Width="140" Height="140" StrokeThickness="14"
                 Stroke="{DynamicResource TrackBrush}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Grid x:Name="SegmentsCanvas"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="PercentageText" FontSize="26" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="used" FontSize="12" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
