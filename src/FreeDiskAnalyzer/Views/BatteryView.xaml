<UserControl x:Class="FreeDiskAnalyzer.Views.BatteryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FreeDiskAnalyzer.Views"
             xmlns:res="clr-namespace:FreeDiskAnalyzer.Resources">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,8,0,16">
            <TextBlock Text="{x:Static res:Strings.Performance_BatteryTitle}" FontWeight="SemiBold" FontSize="16"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20"
                        Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Performance_BatteryBody}" TextWrapping="Wrap"
                                   Style="{StaticResource BodyTextStyle}" Margin="0,0,0,16"/>
                        <Button Content="{x:Static res:Strings.Performance_GenerateBatteryReport}" Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left" Command="{Binding GenerateReportCommand}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                    Visibility="{Binding IsGeneratingReport, Converter={StaticResource BoolToVis}}">
                            <local:LoadingDotsView Margin="0,0,8,0"/>
                            <TextBlock Text="{x:Static res:Strings.Performance_Running}" Style="{StaticResource CaptionTextStyle}"/>
                        </StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Performance_BatteryReportFailed}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"
                                   Margin="0,12,0,0" Visibility="{Binding ReportFailed, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}"
                        Visibility="{Binding HasBattery, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="{x:Static res:Strings.Performance_BatteryNoBattery}" TextWrapping="Wrap"
                               Style="{StaticResource BodyTextStyle}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
